# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，此示例文件可以提交
#
# 任何 OpenAI 兼容端点都可以用，只要改下面三行中的 base_url 和 model：
#   OpenAI        https://api.openai.com/v1      gpt-4o-mini
#   DeepSeek      https://api.deepseek.com       deepseek-flash
#   OpenRouter    https://openrouter.ai/api/v1   anthropic/claude-sonnet-4
#   Ollama（本地）  http://localhost:11434/v1      qwen3:8b
#   vLLM（本地）    http://localhost:8000/v1       你的模型名

LLM_API_KEY=sk-你的-key
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# JSON 模式：auto（默认，遇到 400 自动关闭）| on | off
LLM_JSON_MODE=auto

# 可选：每百万 token 的单价（美元），用于 cost_usd 统计
LLM_PRICE_INPUT=0
LLM_PRICE_OUTPUT=0
